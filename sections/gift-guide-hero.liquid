<section id="GiftGuideHero-{{ section.id }}" class="gift-guide-hero">
  <div class="gift-guide-hero__image">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '750, 1100, 1500, 2000, 2400',
          class: 'gift-guide-hero__background'
      }}
    {% endif %}
  </div>

  <div class="gift-guide-hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="gift-guide-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="gift-guide-hero__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        class="gift-guide-hero__button"
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          role="link"
          aria-disabled="true"
        {% endif %}
      >
        {{ section.settings.button_label }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
</section>

<style>
  #GiftGuideHero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 560px;
    overflow: hidden;
    background: #f4f4f4;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__image {
    position: absolute;
    inset: 0;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__background {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__content {
    position: relative;
    z-index: 2;
    min-height: 560px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__heading {
    margin: 0 0 20px;
    font-size: clamp(44px, 5vw, 72px);
    line-height: 1;
    font-weight: 700;
    color: #111111;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__text {
    max-width: 480px;
    margin-bottom: 28px;
    font-size: 18px;
    line-height: 1.5;
    color: #111111;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__text p {
    margin: 0;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 16px 24px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    transition: opacity .2s ease;
  }

  #GiftGuideHero-{{ section.id }} .gift-guide-hero__button:hover {
    opacity: .8;
  }

  @media screen and (max-width: 749px) {
    #GiftGuideHero-{{ section.id }} {
      min-height: 580px;
    }

    #GiftGuideHero-{{ section.id }} .gift-guide-hero__content {
      min-height: 580px;
      padding: 40px 20px;
      justify-content: flex-end;
      align-items: center;
      text-align: center;
    }

    #GiftGuideHero-{{ section.id }} .gift-guide-hero__heading {
      font-size: 40px;
    }

    #GiftGuideHero-{{ section.id }} .gift-guide-hero__text {
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Discover our curated selection of gifts for everyone.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Hero"
    }
  ]
}
{% endschema %}