<section class="gift-guide-hero">
  <img
    src="{{ 'gift-guide-artwork.svg' | asset_url }}"
    alt="The Gift Guide"
    class="gift-guide-hero__artwork"
    width="1440"
    height="780"
  >
</section>

<style>
  .gift-guide-hero {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .gift-guide-hero__artwork {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .gift-guide-hero__artwork {
      width: 100%;
      height: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Hero",
  "settings": [],
  "presets": [
    {
      "name": "Gift Guide Hero"
    }
  ]
}
{% endschema %}